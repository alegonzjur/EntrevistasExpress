# Copia este fichero a ".env" (en la raíz del proyecto, junto a run.py) y
# rellena los valores reales. ".env" NUNCA se sube a git (ver .gitignore).

# --- Flask ---
# Obligatoria. Genera un valor con:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# --- Base de datos (PostgreSQL) ---
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=entrevistas_db

# --- Correo (Office 365 / SMTP) ---
MAIL_SERVER=smtp.office365.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=

# --- Uploads ---
UPLOAD_FOLDER=uploads
